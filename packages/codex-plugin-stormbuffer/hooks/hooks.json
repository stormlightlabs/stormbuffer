{
	"hooks": {
		"UserPromptSubmit": [
			{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex.mjs\" prompt", "timeout": 10 }] }
		],
		"PostToolUse": [
			{
				"matcher": "^mcp__stormbuffer__memory_(remember|update)$",
				"hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex.mjs\" post-tool", "timeout": 10 }]
			}
		],
		"Stop": [
			{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex.mjs\" stop", "timeout": 10 }] }
		]
	}
}
