{
	"name": "@stormlightlabs/stormbuffer-docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pagefind --site build --output-path static/pagefind --quiet && vite build",
		"deploy": "pnpm run build && wrangler pages deploy",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/google-sans": "^5.3.1",
		"@fontsource-variable/google-sans-code": "^5.3.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@iconify-json/bi": "^1.2.7",
		"@iconify-json/ri": "^1.2.10",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@unocss/preset-icons": "^66.7.5",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"pagefind": "^1.5.2",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^3.23.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unocss": "^66.7.5",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.121.0"
	},
	"dependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"satori": "^0.26.0",
		"satori-html": "^0.3.2"
	}
}
